# muON-DTN Firmware Configuration
mainmenu "muON-DTN Firmware Configuration"

menu "muON Application Settings"
    config MUON_APP_VERSION
        string "muON Firmware Version"
        default "0.1.0"
        help
          Version identifier for muON application stack.

    choice
        prompt "Paper Experiment Node Role"
        default MUON_NODE_ROLE_A
        help
          Select role for reproducing the paper experiment between two Adafruit Feather M0 boards.

        config MUON_NODE_ROLE_A
            bool "Node A (Sensor Source: EID ipn:1.1)"

        config MUON_NODE_ROLE_B
            bool "Node B (Gateway / Relay: EID ipn:2.1)"
    endchoice

    config MUON_LOCAL_NODE_ID
        int "Local Node Number"
        default 1 if MUON_NODE_ROLE_A
        default 2 if MUON_NODE_ROLE_B

    config MUON_REMOTE_NODE_ID
        int "Remote Destination Node Number"
        default 2 if MUON_NODE_ROLE_A
        default 1 if MUON_NODE_ROLE_B
endmenu

menu "muON Network Layer"
    orsource "lib/bpa/Kconfig"
    orsource "lib/clm/Kconfig"
    orsource "lib/routing/Kconfig"
    orsource "lib/lora_cl/Kconfig"
    orsource "lib/uart_cobs_cl/Kconfig"
endmenu

menu "muON Storage Backend Configuration"
    choice
        prompt "muON IStorage Backend"
        default MUON_STORAGE_BACKEND_RAM
        help
          Selects the active IStorage implementation for bundle persistence.
          If SPI Flash is selected, RAM storage is completely disabled to save memory.

    config MUON_STORAGE_BACKEND_RAM
        bool "Internal RAM Storage (ggg::hal::RamStorage)"
        help
          Fast in-memory volatile block storage.

    config MUON_STORAGE_BACKEND_SPI_FLASH
        bool "External SPI NOR Flash Storage (ggg::plugins::SpiFlashStorage)"
        depends on GGG_PLUGIN_SPI_FLASH_STORAGE
        help
          Non-volatile SPI Flash storage (e.g. Winbond W25Q64).
          Only selectable when GGG SPI Flash Storage plugin is enabled.
    endchoice
endmenu

menu "I2C Hardware Bus Configuration"
    config MUON_I2C_SHARED_BUS
        bool "Enable Shared I2C Bus for Peripherals"
        default y
        help
          Enables a shared hardware I2C bus (Wire) for connected peripherals
          (OLED display, BME280 sensor, DS3231 RTC).
          When enabled, all I2C plugins share the common SDA/SCL lines.

    if MUON_I2C_SHARED_BUS
        choice
            prompt "I2C Interface Mode"
            default MUON_I2C_USE_HARDWARE_WIRE
            help
              Use standard MCU hardware Wire peripheral or custom pins.

            config MUON_I2C_USE_HARDWARE_WIRE
                bool "Standard Hardware Wire Peripheral"

            config MUON_I2C_USE_CUSTOM_PINS
                bool "Custom SDA/SCL GPIO Pins"
        endchoice

        if MUON_I2C_USE_CUSTOM_PINS
            config MUON_I2C_PIN_SDA
                int "Shared I2C SDA Pin"
                default 20

            config MUON_I2C_PIN_SCL
                int "Shared I2C SCL Pin"
                default 21
        endif

        config MUON_I2C_CLOCK_SPEED
            int "I2C Bus Clock Frequency (Hz)"
            default 400000
            range 100000 1000000
            help
              Bus speed in Hz (100000 = Standard 100kHz, 400000 = Fast Mode 400kHz).
    endif
endmenu

menu "muON Application Plugins"
    orsource "plugins/*/Kconfig"
endmenu

# Include underlying GGG Core Framework configuration
orsource "../ggg/Kconfig"


