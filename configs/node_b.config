# ==============================================================================
# muON-DTN Configuration Profile: Node B (Gateway / Relay)
# Hardware: Adafruit Feather M0 LoRa + OLED SSD1306 + DS3231 RTC + W25Q64 Flash
# ==============================================================================

# Application & Role
CONFIG_MUON_APP_VERSION="0.1.0"
CONFIG_MUON_NODE_ROLE_B=y
CONFIG_MUON_LOCAL_NODE_ID=2
CONFIG_MUON_REMOTE_NODE_ID=1

# Network Layer: BPA, CLM, Routing
CONFIG_MUON_BPA=y
CONFIG_MUON_BPA_MAX_BUNDLE_METADATA=16
CONFIG_MUON_BPA_MAX_RETRIES=3
CONFIG_MUON_BPA_LOCAL_NODE_ID=2
CONFIG_MUON_BPA_LOCAL_SERVICE_ID=1

CONFIG_MUON_CLM=y
CONFIG_MUON_CLM_MAX_ADAPTERS=4

CONFIG_MUON_ROUTING=y
CONFIG_MUON_ROUTING_MAX_STATIC_ROUTES=8

# Convergence Layer 0: LoRaCL (SX1276)
CONFIG_MUON_LORA_CL_ENABLED=y
CONFIG_MUON_LORA_LINK_ID=0
CONFIG_MUON_LORA_MODEM_SX1276=y
CONFIG_MUON_LORA_PIN_CS=8
CONFIG_MUON_LORA_PIN_DIO0=3
CONFIG_MUON_LORA_PIN_RESET=4
CONFIG_MUON_LORA_FREQ_MHZ=868
CONFIG_MUON_LORA_SF=9
CONFIG_MUON_LORA_BW_KHZ=250
CONFIG_MUON_LORA_CR=5
CONFIG_MUON_LORA_TX_POWER_DBM=14
CONFIG_MUON_LORA_DUTY_CYCLE_ENABLED=y
CONFIG_MUON_LORA_REASSEMBLY_TIMEOUT_MS=5000
CONFIG_MUON_LORA_ACK_TIMEOUT_MS=3000

# Convergence Layer 1: UARTCL-COBS (Dedicated USB Serial to PC / IONe)
CONFIG_MUON_UART_COBS_CL_ENABLED=y
CONFIG_MUON_UART_COBS_LINK_ID=1
CONFIG_MUON_UART_COBS_BAUDRATE=115200
CONFIG_MUON_UART_COBS_TIME_SYNC_ENABLED=y

# Storage Backend: Winbond W25Q64 SPI Flash (CS on Pin 5)
# RAM storage is disabled to preserve SRAM for queues and buffers.
CONFIG_GGG_PLUGIN_SPI_FLASH_STORAGE=y
CONFIG_GGG_STORAGE_FLASH_SPI=y
CONFIG_MUON_STORAGE_BACKEND_SPI_FLASH=y
CONFIG_GGG_SPIFLASH_CS_PIN=5
# CONFIG_MUON_STORAGE_BACKEND_RAM is not set
# CONFIG_GGG_STORAGE_RAM is not set

# Hardware Bus: Shared I2C (Wire)
CONFIG_MUON_I2C_SHARED_BUS=y
CONFIG_MUON_I2C_USE_HARDWARE_WIRE=y
CONFIG_MUON_I2C_CLOCK_SPEED=400000

# muON OLED Display Plugin: SSD1306 (0x3C, I2C)
CONFIG_MUON_PLUGIN_OLED_DISPLAY=y
CONFIG_MUON_OLED_CONTROLLER_SSD1306=y
CONFIG_MUON_OLED_RES_128X64=y
CONFIG_MUON_OLED_BUFFER_PAGE=y
CONFIG_MUON_OLED_I2C_ADDRESS=0x3C
CONFIG_MUON_OLED_APP_SERVICE_ID=10
CONFIG_MUON_OLED_REFRESH_RATE_HZ=2

# muON RTC DS3231 Plugin: Auto-sync from PC via UARTCL-COBS SYNC frames
CONFIG_MUON_PLUGIN_RTC_DS3231=y
CONFIG_MUON_RTC_DS3231_I2C_ADDRESS=0x68
CONFIG_MUON_RTC_AUTO_SYNC_UARTCL=y
CONFIG_MUON_RTC_AUTO_SYNC_BUNDLE=y
CONFIG_MUON_RTC_CACHE_SECONDS=1

# muON LED Actuator Plugin: Consumes command bundles (service 2)
CONFIG_MUON_PLUGIN_LED_ACTUATOR=y
CONFIG_MUON_ACTUATOR_PIN=13
CONFIG_MUON_ACTUATOR_SERVICE_ID=2

# Pushbutton & BME280: Disabled on Node B
# CONFIG_GGG_PLUGIN_BUTTON is not set
# CONFIG_MUON_PLUGIN_SENSOR_BME280 is not set

# Debug Logging (Suppressed automatically on Serial to protect COBS binary stream)
CONFIG_MUON_DEBUG=y
# CONFIG_MUON_DEBUG_USE_SERIAL1 is not set

# RTOS Core
CONFIG_GGG_RTOS_FREERTOS=y
CONFIG_GGG_SYSTEM_BUS_TASK_PRIORITY=3
CONFIG_GGG_SYSTEM_BUS_TASK_STACK_SIZE=512
CONFIG_GGG_SYSTEM_BUS_QUEUE_LENGTH=16
