# node_gateway.ionrc
# Initialization of IONe node 3
1 3 node_gateway.ionconfig
s

# Local loopback contact
a contact +0 +86400 3 3 100000
a range   +0 +86400 3 3 0

# Contact plan for Node 3 (IONe Gateway PC) and Node 2 (muON Node B Gateway MCU)
# UART-COBS at 115200 baud provides ~11520 bytes/sec nominal throughput
a contact +0 +86400 3 2 11520
a contact +0 +86400 2 3 11520
a range   +0 +86400 3 2 0
a range   +0 +86400 2 3 0

# Contact plan for Node 2 (muON Relay MCU) and Node 1 (muON Node A Sensor MCU via LoRa)
# LoRa link nominal throughput (~1000 bytes/sec)
a contact +0 +86400 2 1 1000
a contact +0 +86400 1 2 1000
a range   +0 +86400 2 1 0
a range   +0 +86400 1 2 0

m production 1000000
m consumption 1000000

