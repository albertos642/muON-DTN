# ==============================================================================
# muON-DTN Configuration Profile: Node A (Sensor Source)
# Hardware: Adafruit Feather M0 LoRa + BME280 + DS3231 RTC + Pushbutton
# ==============================================================================

# Application & Role
CONFIG_MUON_APP_VERSION="0.1.0"
CONFIG_MUON_NODE_ROLE_A=y
CONFIG_MUON_LOCAL_NODE_ID=1
CONFIG_MUON_REMOTE_NODE_ID=2

# Network Layer: BPA, CLM, Routing
CONFIG_MUON_BPA=y
CONFIG_MUON_BPA_MAX_BUNDLE_METADATA=16
CONFIG_MUON_BPA_MAX_RETRIES=3
CONFIG_MUON_BPA_LOCAL_NODE_ID=1
CONFIG_MUON_BPA_LOCAL_SERVICE_ID=1

CONFIG_MUON_CLM=y
CONFIG_MUON_CLM_MAX_ADAPTERS=4

CONFIG_MUON_ROUTING=y
CONFIG_MUON_ROUTING_MAX_STATIC_ROUTES=8

# Convergence Layers
CONFIG_MUON_LORA_CL_ENABLED=y
CONFIG_MUON_LORA_LINK_ID=0
CONFIG_MUON_LORA_MODEM_SX1276=y
CONFIG_MUON_LORA_PIN_CS=8
CONFIG_MUON_LORA_PIN_DIO0=3
CONFIG_MUON_LORA_PIN_RESET=4
CONFIG_MUON_LORA_FREQ_MHZ=868
CONFIG_MUON_LORA_SF=9
CONFIG_MUON_LORA_BW_KHZ=250
CONFIG_MUON_LORA_CR=5
CONFIG_MUON_LORA_TX_POWER_DBM=14
CONFIG_MUON_LORA_DUTY_CYCLE_ENABLED=y
CONFIG_MUON_LORA_REASSEMBLY_TIMEOUT_MS=5000
CONFIG_MUON_LORA_ACK_TIMEOUT_MS=3000

# Storage Backend: RAM Storage (volatile zero-malloc pool)
CONFIG_MUON_STORAGE_BACKEND_RAM=y
CONFIG_GGG_STORAGE_RAM=y
# CONFIG_GGG_PLUGIN_SPI_FLASH_STORAGE is not set
# CONFIG_MUON_STORAGE_BACKEND_SPI_FLASH is not set

# Hardware Bus: Shared I2C (Wire)
CONFIG_MUON_I2C_SHARED_BUS=y
CONFIG_MUON_I2C_USE_HARDWARE_WIRE=y
CONFIG_MUON_I2C_CLOCK_SPEED=400000

# GGG Button Plugin: Pushbutton on Pin 5
CONFIG_GGG_PLUGIN_BUTTON=y
CONFIG_GGG_BUTTON_PIN=5
CONFIG_GGG_BUTTON_ACTIVE_LOW_PULLUP=y
CONFIG_GGG_BUTTON_EDGE_FALLING=y
CONFIG_GGG_BUTTON_SAMPLE_INTERVAL_MS=5
CONFIG_GGG_BUTTON_DEBOUNCE_THRESHOLD=6
CONFIG_GGG_BUTTON_EVENT_ID=0x0100
CONFIG_GGG_BUTTON_EVENT_CODE=1

# muON BME280 Plugin: Environmental telemetry to ipn:3.1 upon Button press
CONFIG_MUON_PLUGIN_SENSOR_BME280=y
CONFIG_MUON_BME280_I2C_ADDRESS=0x76
CONFIG_MUON_BME280_TRIGGER_EVENT_ID=0x0100
CONFIG_MUON_BME280_TRIGGER_CODE=1
CONFIG_MUON_BME280_DEST_NODE=3
CONFIG_MUON_BME280_DEST_SERVICE=1
CONFIG_MUON_BME280_BUNDLE_PRIORITY=1
CONFIG_MUON_BME280_BUNDLE_LIFETIME_SEC=3600

# muON RTC DS3231 Plugin: High-precision timestamping
CONFIG_MUON_PLUGIN_RTC_DS3231=y
CONFIG_MUON_RTC_DS3231_I2C_ADDRESS=0x68
CONFIG_MUON_RTC_AUTO_SYNC_UARTCL=n
CONFIG_MUON_RTC_AUTO_SYNC_BUNDLE=y
CONFIG_MUON_RTC_CACHE_SECONDS=1

# muON LED Actuator Plugin: Consumes reverse command bundles (service 2)
CONFIG_MUON_PLUGIN_LED_ACTUATOR=y
CONFIG_MUON_ACTUATOR_PIN=13
CONFIG_MUON_ACTUATOR_SERVICE_ID=2

# Display: Disabled on Node A
# CONFIG_MUON_PLUGIN_OLED_DISPLAY is not set

# Debug Logging (Serial console enabled on Node A)
CONFIG_MUON_DEBUG=y
# CONFIG_MUON_DEBUG_USE_SERIAL1 is not set

# RTOS Core
CONFIG_GGG_RTOS_FREERTOS=y
CONFIG_GGG_SYSTEM_BUS_TASK_PRIORITY=3
CONFIG_GGG_SYSTEM_BUS_TASK_STACK_SIZE=512
CONFIG_GGG_SYSTEM_BUS_QUEUE_LENGTH=16
